PROXY_NETWORK=local-proxy
SHURIKENUI_FRONTEND_HOST=sfc-frontend.localhost
SHURIKENUI_FRONTEND_PORT=3000
TRAEFIK_ENTRYPOINTS=web
# Caddy terminates TLS before forwarding to Traefik's HTTP entrypoint.
TRAEFIK_TLS=false
NUXT_PUBLIC_API_BASE_URL=https://scac-backend.localhost
# npm automation token used by ./local/pnpm publish; do not commit a real token.
NPM_TOKEN=
