#!/usr/bin/env sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
compose_file="${script_dir}/dev/compose.yaml"
env_file="${script_dir}/dev/.env"

if [ -f "${env_file}" ]; then
    exec docker compose --env-file "${env_file}" -f "${compose_file}" run --rm --no-deps shuriken-ui pnpm "$@"
fi

exec docker compose -f "${compose_file}" run --rm --no-deps shuriken-ui pnpm "$@"
